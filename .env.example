# Copy to .env.local and fill in. Nothing here is read at build time.

# Which provider to use: openai | anthropic | mock
# `mock` streams canned text and needs no key — useful for UI work and tests.
LLM_PROVIDER=mock

# Model id for the selected provider.
# LLM_MODEL=gpt-4o-mini
# LLM_MODEL=claude-3-5-sonnet-latest

# Only the key for the provider you selected is needed.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: OpenAI-compatible gateway (leave unset for api.openai.com).
# OPENAI_BASE_URL=https://...

# Max tokens per reply (Anthropic only; default 2048).
# LLM_MAX_TOKENS=2048

# SQLite file. Created on first run, along with its directory.
DB_PATH=./data/feynman.db

# Optional shared secret. When set, /api/chat requires
#   Authorization: Bearer <APP_TOKEN>
# Leave unset for local use. Set it before exposing this app to a network —
# there is no login, so this token is the only thing between the internet and
# your API key.
# APP_TOKEN=
